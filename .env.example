# Copy to .env and adjust: cp .env.example .env
# Never commit .env — it is in .gitignore.

# App
APP_ENV=development              # development | production
APP_BASE_URL=http://localhost:8000
SECRET_KEY=change-me             # Sessions and itsdangerous tokens (min 32 characters in production)
ENCRYPTION_KEY=                  # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEBUG=true

# Database
DATABASE_URL=sqlite:///./unfurl.db
# Production: postgresql+psycopg://user:pass@host:5432/unfurl

# Postgres container (docker compose only; local development values)
POSTGRES_USER=unfurl
POSTGRES_PASSWORD=unfurl
POSTGRES_DB=unfurl

# Email
EMAIL_BACKEND=console            # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Unfurl <no-reply@example.com>"

# AI
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
AI_GLOBAL_DAILY_CREDITS=3000
# Plan limits are not in env; they are defined in app/billing/plans.py.

# Billing (off in the MVP)
BILLING_ENABLED=false            # Until true, Upgrade buttons lead to the waitlist

# Extension
EXTENSION_ORIGINS=chrome-extension://REPLACE_WITH_EXTENSION_ID

# Scheduler / reminders
SCHEDULER_ENABLED=true           # false in tests and when running more than one instance
DEFAULT_TIMEZONE=Europe/Vienna

# Uploads
UPLOAD_DIR=./uploads
