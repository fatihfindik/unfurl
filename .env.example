# Copy to .env and adjust: cp .env.example .env
# Never commit .env — it is in .gitignore.

# App
APP_ENV=development              # Required: development | production (the app won't start without it)
APP_BASE_URL=http://localhost:8000   # Also the host name the app answers to, besides localhost and 127.0.0.1 (D-168)
SECRET_KEY=change-me             # Sessions and itsdangerous tokens (min 32 characters in production)
ENCRYPTION_KEY=                  # Fernet key: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"  (a Fernet key; cryptography comes with BYOK, V2)
DEBUG=true                       # Must be false in production (the app won't start otherwise)

# Database
DATABASE_URL=sqlite:///./unfurl.db
# Production: postgresql+psycopg://user:pass@host:5432/unfurl

# Postgres container (docker compose only; local development values)
POSTGRES_USER=unfurl
POSTGRES_PASSWORD=unfurl         # Local only. Production: a long, randomly generated password
POSTGRES_DB=unfurl

# Email
EMAIL_BACKEND=console            # console (prints emails in the terminal) | smtp. Production: smtp, required
SMTP_HOST=                       # Required in production
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Unfurl <no-reply@example.com>"

# AI: V2 (D-150), not used in the MVP
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
AI_GLOBAL_DAILY_CREDITS=3000
# Plan limits are not in env; they are defined in app/billing/plans.py.

# Billing (off in the MVP)
BILLING_ENABLED=false            # Until true, Upgrade buttons lead to the waitlist

# Extension
# The id of the unpacked extension (fixed by "key" in extension/manifest.json, D-137).
EXTENSION_ORIGINS=chrome-extension://kjeninhhhleogjjnmplhbhifjnafmkmd

# Scheduler / reminders
SCHEDULER_ENABLED=true           # notification jobs (D-103). Only ONE worker/server may have it on; false in tests
DEFAULT_TIMEZONE=Europe/Vienna

# Uploads
UPLOAD_DIR=./uploads

# Legal pages (D-133): the Impressum's operator. Personal data: only here, never in the repo.
LEGAL_OPERATOR_NAME=
LEGAL_ADDRESS=                   # one line, e.g. "Street 1, 1010 Vienna, Austria"
LEGAL_EMAIL=
LEGAL_REVIEWED=false             # true after a lawyer reviewed the texts: the "Draft" band goes away
