# Settings for the personal local instance (docker-compose.personal.yml, D-155, D-156).
# Copy once: cp .env.personal.example .env.personal
# Never commit .env.personal — it is in .gitignore. It holds your own keys and password.
# Keep a copy somewhere safe (a password manager): backups don't include it, and
# without ENCRYPTION_KEY encrypted fields can't be read after a restore.

# App
# Development mode, because production needs a real mail server (D-156).
APP_ENV=development
DEBUG=false
# 127.0.0.1, not localhost: the development server on localhost:8000 then keeps its
# own sign-in cookie.
APP_BASE_URL=http://127.0.0.1:8100
# Required. Make each one once and keep it (a new SECRET_KEY signs everyone out):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Database (the instance's own Postgres container)
POSTGRES_USER=unfurl
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# (letters, digits, - and _ only: it goes into a database URL)
POSTGRES_PASSWORD=
POSTGRES_DB=unfurl_personal

# Email: printed in the logs, not sent. Links (verify, password reset) are read with
#   docker compose -f docker-compose.personal.yml --env-file .env.personal logs app
EMAIL_BACKEND=console
EMAIL_FROM="Unfurl <no-reply@example.com>"

# Extension (same unpacked extension as in development, D-137)
EXTENSION_ORIGINS=chrome-extension://kjeninhhhleogjjnmplhbhifjnafmkmd

# Scheduler / reminders: on, this is the only server for this database (D-103)
SCHEDULER_ENABLED=true
DEFAULT_TIMEZONE=Europe/Vienna

# Legal pages: not needed for personal use
LEGAL_OPERATOR_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_REVIEWED=false
